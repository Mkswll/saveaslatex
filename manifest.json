{
  "manifest_version": 3,
  "name": "Save as LaTeX",
  "version": "1.3.3",
  "description": "Read a math assignment page and save it as a LaTeX homework file.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "sidePanel", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Save assignment as LaTeX",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
